# Candidate public HTTP boundary; do not install until the production deployment,
# DNS, offsite backups and end-to-end security review are independently ready.
# This is not the private HTTPS preview gate.
http://{$XENNIC_PUBLIC_HOST:xennic.ir}:{$XENNIC_PUBLIC_PORT:80} {
    route {
        @safe_method method GET HEAD
        handle @safe_method {
            @public path / /company /company/about /company/team /services /services/industrial-electrical-consulting /services/building-electrical-design /services/distribution-supervision /services/energy-audit /services/grounding-lightning-protection /services/technical-training /track-record /knowledge /tools /platform /contact /privacy /terms /cookies /_next/static/*
            handle @public {
                reverse_proxy 127.0.0.1:3000 {
                    header_up -Cookie
                    header_up -Authorization
                    header_down -Set-Cookie
                    header_down Cache-Control "no-store"
                }
            }
            respond "Not found" 404
        }
        respond "Not found" 404
    }
}
