# Candidate only. Do not install or expose this listener until the reviewed
# apex gateway configuration, OAuth, health guards and upgrade are complete.
{
    admin off
    # Reject HTTPS requests whose Host differs from the TLS server name.
    servers {
        strict_sni_host on
    }
}

https://xennic.ir {
    import /etc/caddy/routes.caddy
}

# Internal Docker-only probe, never a substitute for identity/TLS validation.
:8080 {
    import /etc/caddy/routes.caddy
}
