FROM node:22.22.3-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 XENNIC_PREVIEW=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# The build doesn't connect to a database; these are non-secret placeholders.
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build PAYLOAD_SECRET=build-only-placeholder-not-a-real-secret npm run build

FROM node:22.22.3-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 XENNIC_PREVIEW=1 PORT=3000 MEDIA_DIR=/app/media
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/media && chown node:node /app/media
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=4s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
